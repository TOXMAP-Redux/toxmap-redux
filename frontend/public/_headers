# TOXMAP Security Headers for Cloudflare Pages (Story 7.4.1)
# DuckDB WASM requires SharedArrayBuffer → COEP + COOP mandatory.
#
# See: ADR-004 (zero-budget hosting), agents/security-engineer/prompt.md §CSP
/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' https://tiles.openfreemap.org https://photon.komoot.io https://*.r2.dev https://*.cloudflarestorage.com; img-src 'self' data: blob: https://tiles.openfreemap.org; style-src 'self' 'unsafe-inline'; font-src 'self' https://tiles.openfreemap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
