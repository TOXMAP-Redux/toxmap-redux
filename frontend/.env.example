VITE_API_BASE_URL=http://localhost:8000
VITE_DATA_SOURCE=api
VITE_R2_BASE_URL=https://pub-XXXXX.r2.dev
# Basemap tile style — OpenFreeMap Liberty (free, no API key). ADR-005.
# For local dev and production: https://tiles.openfreemap.org/styles/liberty
# Self-hosted fallback (Phase 7 optional): https://pub-XXXXX.r2.dev/basemap_us.pmtiles
VITE_MAPLIBRE_STYLE=https://tiles.openfreemap.org/styles/liberty
# VITE_NOMINATIM_UA is unused — geocoding moved to browser-direct Photon (ADR-006).
# If you restore backend-proxy geocoding, set this to a valid contact URL:
# VITE_NOMINATIM_UA=toxmap-clone/0.1 (github.com/TOXMAP-Redux/toxmap-redux)
